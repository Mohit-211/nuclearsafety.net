# /etc/nginx/sites-available/nuclearsafety.net  (example — adjust domain/paths)
# TLS via certbot: `certbot --nginx -d nuclearsafety.net -d www.nuclearsafety.net`

server {
    listen 80;
    server_name nuclearsafety.net www.nuclearsafety.net;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name nuclearsafety.net www.nuclearsafety.net;

    # ssl_certificate / ssl_certificate_key are added by certbot.

    # Must be >= SCORM_MAX_UPLOAD_MB in .env (SCORM ZIPs with video can be large).
    client_max_body_size 1100m;

    # Long-running package uploads/extraction.
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;

    # Stream uploads straight to Next.js instead of buffering them on nginx's disk.
    location /api/admin/packages {
        proxy_request_buffering off;
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/snippets/next-proxy.conf;
    }

    # Brute-force protection for sign-in (Server Actions POST to /login).
    location = /login {
        limit_req zone=login burst=10 nodelay;
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/snippets/next-proxy.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/snippets/next-proxy.conf;
    }
}

# In the http {} block (e.g. /etc/nginx/conf.d/limits.conf):
#   limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;

# /etc/nginx/snippets/next-proxy.conf:
#   proxy_http_version 1.1;
#   proxy_set_header Host $host;
#   proxy_set_header X-Real-IP $remote_addr;
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_set_header X-Forwarded-Host $host;
#   proxy_set_header Upgrade $http_upgrade;
#   proxy_set_header Connection "upgrade";
