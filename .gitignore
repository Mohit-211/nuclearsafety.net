# =============================================================================
# nuclearsafety.net — SCORM training platform
# =============================================================================

# --- Dependencies -------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Build output -----------------------------------------------------------------
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts
.turbo
.swc

# --- Environment & secrets (NEVER commit) ------------------------------------------
# All configuration lives in .env (template: .env.example).
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*
.npmrc

# --- Runtime data -----------------------------------------------------------------
# Uploaded/extracted SCORM packages and temp uploads (back these up, never commit).
/storage
/storage-*
# Raw SCORM ZIPs / course exports dropped into the repo by mistake.
*.zip
# Database dumps / backups
*.sql.gz
*.dump
/backups
# Generated migrations ARE committed (drizzle/*.sql) — do not ignore *.sql.

# --- Logs & process managers --------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/app.log
.pm2/

# --- Testing ----------------------------------------------------------------------
/coverage
/test-results
/playwright-report
/playwright/.cache
.vitest

# --- Editors / OS -----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
# Keep only the shared VS Code workspace files.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Local AI-assistant settings (per-developer permissions) -------------------------
.claude/

# --- Hosting ------------------------------------------------------------------------
.vercel
